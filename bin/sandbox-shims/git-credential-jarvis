#!/usr/bin/env bash
# git's credential helper inside the sandbox: asks the bot for a token scoped to the
# repo, with the caller's WORKER ticket, and prints nothing when it has none (git then
# goes on without credentials: a public clone works, a private push says it needs a ticket).
#
#   git-credential-jarvis get      (git writes protocol/host/path on stdin)
#
# It reuses the bot's ticket-checked `git-auth` action: the same rule that decides who
# gets a push token for `bin/github-app.sh push` decides here, and a ticket without
# `push` gets identity only, which is no credential.
set -uo pipefail
[ "${1:-}" = get ] || exit 0

host="" path=""
while IFS='=' read -r k v; do
  case "$k" in host) host=$v ;; path) path=$v ;; esac
done
[ "$host" = github.com ] || exit 0

repo=$(printf '%s' "$path" | sed -E 's#\.git$##')
if ! printf '%s' "$repo" | grep -Eq '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$'; then
  repo=$(git remote get-url origin 2>/dev/null | sed -E -e 's#\.git$##' -e 's#^.*github\.com[:/]##')
fi
printf '%s' "$repo" | grep -Eq '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$' || exit 0

ticket=${JARVIS_RUN_TICKET:-}
[ -z "$ticket" ] && [ -n "${JARVIS_RUN_TICKET_FILE:-}" ] && ticket=$(sed -n 1p "$JARVIS_RUN_TICKET_FILE" 2>/dev/null | tr -d '[:space:]')
[ -n "$ticket" ] && [ -n "${JARVIS_PROXY_URL:-}" ] || exit 0

answer=$(curl -sS --max-time 30 -H 'Content-Type: application/json' \
  --data-binary "$(jq -n --arg t "$ticket" --arg r "$repo" '{action:"git-auth", repo:$r, purpose:"push", ticket:$t}')" \
  "$JARVIS_PROXY_URL/api/github-app/action" 2>/dev/null) || exit 0
token=$(printf '%s' "$answer" | jq -r '.github.token // empty' 2>/dev/null)
[ -n "$token" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$token"
